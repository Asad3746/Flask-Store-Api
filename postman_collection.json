  "item": [
    {
      "name": "Create Cart",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "let jsonData = pm.response.json();\r",
              "\r",
              "pm.test(\"✅ Status code is 201\", function () {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "pm.test(\"✅ Response time under 500ms\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(500);\r",
              "});\r",
              "pm.test(\"✅ Success is true\", function () {\r",
              "    pm.expect(jsonData.success).to.eql(true);\r",
              "});\r",
              "pm.test(\"✅ Message is correct\", function () {\r",
              "    pm.expect(jsonData.message).to.eql(\"Cart created successfully\");\r",
              "});\r",
              "pm.test(\"✅ Data object exists\", function () {\r",
              "    pm.expect(jsonData.data).to.not.be.null;\r",
              "});\r",
              "pm.test(\"✅ cart_id exists and is a number\", function () {\r",
              "    pm.expect(jsonData.data).to.have.property(\"cart_id\");\r",
              "    pm.expect(jsonData.data.cart_id).to.be.a(\"number\");\r",
              "});\r",
              "pm.test(\"✅ cart_id is positive\", function () {\r",
              "    pm.expect(jsonData.data.cart_id).to.be.above(0);\r",
              "});\r",
              "pm.test(\"✅ Cart status is active\", function () {\r",
              "    pm.expect(jsonData.data.status).to.eql(\"active\");\r",
              "});\r",
              "pm.test(\"✅ Response has all 3 top level fields\", function () {\r",
              "    pm.expect(jsonData).to.have.all.keys(\"success\", \"message\", \"data\");\r",
              "});\r",
              "pm.test(\"✅ No error field on success\", function () {\r",
              "    pm.expect(jsonData).to.not.have.property(\"error\");\r",
              "});\r",
              "\r",
              "// Save cart_id for all other requests\r",
              "// Save cart_id for all other requests\r",
              "pm.environment.set(\"cart_id\", jsonData.data.cart_id);\r",
              "console.log(\"Cart ID saved:\", jsonData.data.cart_id);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
