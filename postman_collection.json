    {
      "name": "[NEG] Checkout - Cart Not Active",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "let jsonData = pm.response.json();\r",
              "\r",
              "pm.test(\"❌ Status 400 for cart not active\", function () {\r",
              "    pm.response.to.have.status(400);\r",
              "});\r",
              "pm.test(\"❌ Response time under 5000ms\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(5000);\r",
              "});\r",
              "pm.test(\"❌ Success is false\", function () {\r",
              "    pm.expect(jsonData.success).to.eql(false);\r",
              "});\r",
              "pm.test(\"❌ Code is CART_NOT_ACTIVE\", function () {\r",
              "    pm.expect(jsonData.code).to.eql(\"CART_NOT_ACTIVE\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Create a cart, add item, checkout it, then this test \r",
              "// tries to checkout again → CART_NOT_ACTIVE\r",
              "const baseUrl = pm.environment.get(\"base_url\");\r",
              "const userId = Date.now() % 100000;\r",
              "\r",
              "// Step 1: Create cart\r",
              "pm.sendRequest({\r",
              "    url: baseUrl + \"/cart\",\r",
              "    method: \"POST\",\r",
              "    header: { \"Content-Type\": \"application/json\" },\r",
              "    body: {\r",
              "        mode: \"raw\",\r",
              "        raw: JSON.stringify({ \"user_id\": userId })\r",
              "    }\r",
              "}, function(err, res) {\r",
              "    const cartId = res.json().data.cart_id;\r",
              "    \r",
              "    // Step 2: Add item\r",
              "    pm.sendRequest({\r",
              "        url: baseUrl + \"/cart/items/\" + cartId,\r",
              "        method: \"POST\",\r",
              "        header: { \"Content-Type\": \"application/json\" },\r",
              "        body: {\r",
              "            mode: \"raw\",\r",
              "            raw: JSON.stringify({ \"product_id\": 1, \"quantity\": 1 })\r",
              "        }\r",
              "    }, function(err2, res2) {\r",
              "        \r",
              "        // Step 3: Checkout once\r",
              "        pm.sendRequest({\r",
              "            url: baseUrl + \"/orders\",\r",
              "            method: \"POST\",\r",
              "            header: { \"Content-Type\": \"application/json\" },\r",
              "            body: {\r",
              "                mode: \"raw\",\r",
              "                raw: JSON.stringify({ \"cart_id\": cartId })\r",
              "            }\r",
              "        }, function(err3, res3) {\r",
              "            // Now cart is checked_out\r",
              "            pm.environment.set(\"inactive_cart_id\", cartId);\r",
              "            console.log(\"Inactive cart ready:\", cartId);\r",
              "        });\r",
              "    });\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
